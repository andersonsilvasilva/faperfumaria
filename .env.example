# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca commitar o arquivo ".env" (já está no .gitignore).

# Desenvolvimento: use um MySQL local (ex.: Laragon) para não esbarrar em limites de conexão
# de hospedagem compartilhada. Produção: ver docs/deployment.md.
DATABASE_URL="mysql://root:@127.0.0.1:3306/fa_perfumaria"

AUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# "mock" (padrão/seguro) ou "mercadopago" (real). Ver docs/integrations.md.
PAYMENT_PROVIDER="mock"

MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""

SHIPPING_PROVIDER="mock"
SHIPPING_API_TOKEN=""

# "mock" (padrão/seguro), "gmail" (real, via Gmail API/OAuth2) ou "smtp" (real, via SMTP
# genérico — ex.: caixa de e-mail da própria hospedagem). Ver docs/integrations.md.
EMAIL_PROVIDER="mock"
EMAIL_FROM="FA Perfumaria <naoresponda@faperfumaria.com.br>"
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Usado só quando EMAIL_PROVIDER="smtp".
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
